# ─────────────────────────────────────────────────────────────────────────────
# AliceQI · BlackRoad OS, Inc.
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://aliceqi.com

# ── Clerk (OAuth / Authentication) ────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk redirect paths (defaults work for most setups)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Stripe (Payments) ──────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs for each plan
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── BlackRoad AI Proxy (routes all AI calls through your infra) ────────────
# Base URL of your BlackRoad AI gateway (e.g. a Cloudflare Worker or Pi relay)
BLACKROAD_AI_ENDPOINT=https://api.blackroad.io
# Internal service-to-service secret set on your gateway
BLACKROAD_AI_SECRET=...

# ── Cloudflare ─────────────────────────────────────────────────────────────
# Required by wrangler / GitHub Actions deploy workflow
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...

# ── Tailscale (optional — for private mesh routing) ───────────────────────
# Set on your gateway host, not in this app
# TAILSCALE_AUTH_KEY=tskey-...
